# =============================================================
# Storky App – environment variables
# Skopíruj na .env.local a doplň reálne hodnoty.
# =============================================================

# --- Supabase (auth + Postgres + Storage) ---
# Nájdeš v Supabase dashboarde → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key – server-only, NIKDY do klienta. Bypassuje RLS.
# Zatiaľ ho nepoužívame v kóde, ale Netlify env vars ho môže mať pre budúce
# privileged operácie (napr. admin seed scripty).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Claude API (AI agent na generovanie storiek) ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Whitelist override (optional) ---
# Default v `src/lib/auth.ts`. Override iba ak by Lydka/Verča menili email.
LYDKA_EMAIL=lydia.machova@gmail.com
VERCA_EMAIL=kamenicka.veronika@gmail.com
